rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email.matches('.*@dimigo\\.hs\\.kr$');
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == 'admin';
    }

    function canReadPrinter(printerId) {
      return signedIn() && (
        isAdmin() ||
        printerId in userDoc().data.allowedPrinters
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /printers/{printerId} {
      allow read: if canReadPrinter(printerId);
      allow write: if false;
    }

    match /printJobs/{jobId} {
      allow read: if canReadPrinter(resource.data.printerId);
      allow write: if false;
    }

    match /snapshots/{snapshotId} {
      allow read: if canReadPrinter(resource.data.printerId);
      allow write: if false;
    }

    match /aiAnalyses/{analysisId} {
      allow read: if canReadPrinter(resource.data.printerId);
      allow write: if false;
    }

    match /alerts/{alertId} {
      allow read: if canReadPrinter(resource.data.printerId);
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userLabel in ['normal', 'failure', 'not_sure']
        && canReadPrinter(request.resource.data.printerId);
      allow update, delete: if false;
    }

    match /deviceTokens/{tokenId} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token == tokenId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /webrtcSessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.viewerUid == request.auth.uid
        && canReadPrinter(request.resource.data.printerId);
      allow read, update: if signedIn()
        && resource.data.viewerUid == request.auth.uid
        && canReadPrinter(resource.data.printerId);
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read, create: if signedIn()
          && get(/databases/$(database)/documents/webrtcSessions/$(sessionId)).data.viewerUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/webrtcSessions/$(sessionId)).data.viewerUid == request.auth.uid;
        allow write: if false;
      }
    }
  }
}
