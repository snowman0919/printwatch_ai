#!/bin/sh
set -eu
config=/boot/firmware/printwatch.env
if [ "$(wc -l < "$config")" -ne 6 ] ||
   ! grep -qx 'PRINTWATCH_SERVER_URL="https://3dp.kotori9.run"' "$config" ||
   ! grep -Eq '^PRINTWATCH_PRINTER_ID="printer-[1-3]"$' "$config" ||
   ! grep -Eq '^PRINTWATCH_DEVICE_TOKEN="[A-Za-z0-9_-]{24,}"$' "$config" ||
   ! grep -qx 'PRINTWATCH_LIVE_INTERVAL="1"' "$config" ||
   ! grep -qx 'PRINTWATCH_OLED_ADDRESS="0x3C"' "$config" ||
   ! grep -qx 'PRINTWATCH_SERIAL_DEVICE="auto"' "$config"; then
  echo "Invalid PrintWatch boot configuration" >&2
  exit 1
fi
printer_id=$(sed -n 's/^PRINTWATCH_PRINTER_ID="\(printer-[1-3]\)"$/\1/p' "$config")
install -m 0600 "$config" /etc/printwatch-agent.env
hostnamectl set-hostname "printwatch-${printer_id#printer-}"
rm -f /boot/firmware/printwatch.env
systemctl disable printwatch-firstboot.service
