{
  "printer_id": "Printer-1",
  "capture_interval_sec": 300,
  "firebase_upload_url_or_storage_target": "https://REGION-PROJECT_ID.cloudfunctions.net/uploadSnapshot",
  "device_id": "pi-printer-1",
  "device_secret": "${PRINTWATCH_DEVICE_SECRET}",
  "camera_width": 1920,
  "camera_height": 1080,
  "ai_image_width": 768,
  "thumbnail_width": 480,
  "local_buffer_dir": "/var/lib/printwatch_ai/buffer",
  "lcd_crop": {
    "x": 1300,
    "y": 650,
    "width": 520,
    "height": 260
  },
  "webrtc": {
    "enabled": false,
    "width": 640,
    "height": 480,
    "fps": 2
  }
}
